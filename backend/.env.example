DATABASE_URL="postgresql://user:password@localhost:port/database"

# Role de runtime da app — SEM privilégio de owner das tabelas (ao contrário
# de DATABASE_URL), para que as políticas de RLS (migration add_tenant_rls)
# valam de verdade. Criada automaticamente em dev pela migration
# add_app_runtime_role; em produção, crie-a fora do histórico de migrations
# versionado e aponte esta URL para suas credenciais via secrets.
APP_DATABASE_URL="postgresql://app_runtime:app_runtime@localhost:port/database"

# Cache de permissões (P7.5) — opcional em dev: sem Redis no ar, a app sobe
# normalmente e cada checagem de permissão cai para o Postgres (fail-open,
# ver PermissionCacheService). Em produção, recomendado para revogação quase
# imediata de permissões sem precisar encurtar o access token.
REDIS_URL="redis://localhost:6379"

JWT_SECRET="replace-with-a-strong-random-secret"

# Assina os cookies (helmet/fastify-cookie) para evitar tampering. Gere um
# valor aleatório (ex.: `openssl rand -hex 32`) — nunca reuse o JWT_SECRET.
COOKIE_SECRET="replace-with-a-strong-random-secret"

# Origens com permissão de CORS, separadas por vírgula. Em BFF normalmente só
# existe uma origem confiável: o servidor Next.
CORS_ORIGINS="http://localhost:3000"

PORT=5000
