DATABASE_URL="postgresql://user:password@localhost:port/database"

# Role de runtime da app — SEM privilégio de owner das tabelas (ao contrário
# de DATABASE_URL), para que as políticas de RLS (migration add_tenant_rls)
# valam de verdade. Criada automaticamente em dev pela migration
# add_app_runtime_role; em produção, crie-a fora do histórico de migrations
# versionado e aponte esta URL para suas credenciais via secrets.
APP_DATABASE_URL="postgresql://app_runtime:app_runtime@localhost:port/database"

# Cache de permissões (P7.5) — opcional em dev: sem Redis no ar, a app sobe
# normalmente e cada checagem de permissão cai para o Postgres (fail-open,
# ver PermissionCacheService). Em produção, recomendado para revogação quase
# imediata de permissões sem precisar encurtar o access token.
REDIS_URL="redis://localhost:6379"

JWT_SECRET="replace-with-a-strong-random-secret"

# Assina os cookies (helmet/fastify-cookie) para evitar tampering. Gere um
# valor aleatório (ex.: `openssl rand -hex 32`) — nunca reuse o JWT_SECRET.
COOKIE_SECRET="replace-with-a-strong-random-secret"

# Origens com permissão de CORS, separadas por vírgula. Em BFF normalmente só
# existe uma origem confiável: o servidor Next.
CORS_ORIGINS="http://localhost:3000"

PORT=5000

# development | test | production — controla logger (pretty vs. estruturado),
# Swagger (só fora de produção) e detalhe de erro de validação. Default
# "development" se omitida (ver core/config/env.schema.ts).
NODE_ENV=development

# Storage (Fase 6, ADR 0010) — "local" (default) grava em disco e assina
# URLs com COOKIE_SECRET; "s3" fala com AWS S3, Cloudflare R2 ou MinIO
# (defina S3_ENDPOINT pra R2/MinIO; deixe vazio pra AWS S3 de verdade).
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage
STORAGE_LOCAL_PUBLIC_URL="http://localhost:5000"
UPLOAD_MAX_SIZE_BYTES=5242880

# Só usadas quando STORAGE_DRIVER=s3.
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Mail (Fase 7, ADR 0011) — "console" (default) só loga o e-mail, não
# envia nada; "smtp" usa nodemailer; "resend" fala com a API REST do
# Resend direto (sem SDK).
MAIL_DRIVER=console
MAIL_FROM=

# Só usadas quando MAIL_DRIVER=smtp.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false

# Só usada quando MAIL_DRIVER=resend.
RESEND_API_KEY=

# Base pros links nos e-mails (convite, reset de senha, verificação...).
FRONTEND_URL="http://localhost:3000"

# Jobs agendados (Fase 10.1) — prazo de retenção da auditoria em dias; o job
# diário em core/jobs apaga registros mais antigos que isso. Default 365.
AUDIT_RETENTION_DAYS=365

# Monitoramento de erros (Fase 10.2) — "console" (default) só loga, como
# hoje; "sentry" manda exceções não tratadas pro Sentry (exige SENTRY_DSN).
MONITORING_DRIVER=console
SENTRY_DSN=
