// This is your Prisma schema file,
// learn more in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider     = "prisma-client"
  output       = "../src/core/prisma/generated"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Status {
  ACTIVE
  INACTIVE
  SUSPENDED
  ARCHIVED
}

enum RoleType {
  ADMIN
  USER
  GUEST
}

enum PermissionType {
  READ
  WRITE
  DELETE
}

enum ContactType {
  EMAIL
  PHONE
  SOCIAL
}

enum AuditType {
  LOGIN
  LOGOUT
  DATA_CHANGE
  PERMISSION_CHANGE
}

enum ReportType {
  BUG
  FEATURE_REQUEST
  OTHER
  REPORT
  ANALYTICS
  QUALITY
  QUANTITY
}

enum DocumentType {
  CPF
  RG
  CNH
  NIS
  PIS
  PASEP
  TITULO_ELEITOR
  CERTIDAO_NASCIMENTO
  CERTIDAO_CASAMENTO
  PASSAPORTE
  CARTEIRA_TRABALHO
  RESERVISTA
  RNE
  CPF_RESPONSAVEL
}

enum AddressType {
  HOME
  WORK
}

/// Status of a task lifecycle.
enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

/// Priority level of a task.
enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

/// Defines the legal/institutional nature of the tenant.
enum TenantCategory {
  ASSOCIATION
  FOUNDATION
  RELIGIOUS_ORGANIZATION
  SOCIAL_COOPERATIVE
  OTHER
}

/// Defines the tenant's main area of activity.
enum TenantServiceArea {
  SOCIAL_ASSISTANCE
  EDUCATION
  HEALTH
  RIGHTS_ADVOCACY
  CULTURE
  ENVIRONMENT
  ADVISORY_SUPPORT
  ECONOMIC_DEVELOPMENT
  PROFESSIONAL_TRAINING
  OTHER
}

/// Defines the type of partnership the tenant has with public institutions.
enum PartnershipType {
  NONE
  COLLABORATION_TERM
  FOMENT_TERM
  COOPERATION_AGREEMENT
}

/// Defines the geographic scope of the tenant's activity.
enum CoverageArea {
  NEIGHBORHOOD
  MUNICIPAL
  INTERCITY
  STATE
  REGIONAL
  NATIONAL
  INTERNATIONAL
}

/// Defines the approximate organizational size.
enum OrganizationSize {
  MICRO
  SMALL
  MEDIUM
  LARGE
}

/// Defines the role a person occupies in the tenant's board structure.
enum BoardRoleType {
  PRESIDENT
  VICE_PRESIDENT
  SECRETARY
  VICE_SECRETARY
  TREASURER
  VICE_TREASURER
  BOARD_MEMBER
  FISCAL_COUNCIL_MEMBER
  LEGAL_REPRESENTATIVE
  OTHER
}

/// Defines the institutional or regulatory document type of a tenant.
enum TenantDocumentType {
  BYLAWS
  MEETING_MINUTES
  ELECTION_MINUTES
  APPOINTMENT_TERM
  REGISTRATION_CERTIFICATE
  TAX_DOCUMENT
  FINANCIAL_STATEMENT
  ACCOUNTABILITY_REPORT
  ANNUAL_REPORT
  INTERNAL_REGULATION
  OTHER
}

/// Main organizational entity of the system.
model Tenant {
  id String @id @default(uuid()) @db.Uuid

  legalName          String @unique @db.VarChar(255)
  tradeName          String? @db.VarChar(255)
  registrationNumber String @unique @db.VarChar(20)
  slug               String @unique @db.VarChar(120)

  description String? @db.Text
  mission     String? @db.Text
  vision      String? @db.Text
  values      String? @db.Text

  category           TenantCategory
  primaryServiceArea TenantServiceArea
  partnershipType    PartnershipType @default(NONE)
  coverageArea       CoverageArea?
  organizationSize   OrganizationSize?

  foundedAt DateTime?
  closedAt  DateTime?

  street     String? @db.VarChar(255)
  number     String? @db.VarChar(50)
  district   String? @db.VarChar(150)
  city       String? @db.VarChar(150)
  state      String? @db.VarChar(100)
  zipCode    String? @db.VarChar(20)
  country    String? @db.VarChar(100)
  complement String? @db.VarChar(255)
  reference  String? @db.VarChar(255)

  phone       String? @db.VarChar(20)
  mobilePhone String? @db.VarChar(20)
  email       String? @db.VarChar(255)
  website     String? @db.VarChar(255)
  instagram   String? @db.VarChar(255)
  facebook    String? @db.VarChar(255)
  linkedin    String? @db.VarChar(255)

  usesVolunteers           Boolean @default(false)
  acceptsDonations         Boolean @default(false)
  hasGovernmentPartnership Boolean @default(false)
  isNonProfit              Boolean @default(true)

  notes String? @db.Text

  status    Status    @default(ACTIVE)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  serviceAreas     TenantArea[]
  users            User[]
  roles            Role[]
  userRoles        UserRole[]
  rolePermissions  RolePermission[]
  permissions      Permission[]
  audits           Audit[]
  boardTerms       TenantBoardTerm[]
  boardMembers     TenantBoardMember[]
  documents        TenantDocument[]
  people           Person[]
  reports          Report[]
  tasks            Task[]

  @@index([slug])
  @@index([registrationNumber])
  @@index([category])
  @@index([primaryServiceArea])
  @@index([status])
  @@map("tenants")
}

model TenantArea {
  id       String            @id @default(uuid()) @db.Uuid
  tenantId String            @db.Uuid
  area     TenantServiceArea

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, area])
  @@index([area])
  @@map("tenant_areas")
}

model TenantBoardMember {
  id          String @id @default(uuid()) @db.Uuid
  tenantId    String @db.Uuid
  boardTermId String @db.Uuid
  personId    String @db.Uuid

  role      BoardRoleType
  title     String? @db.VarChar(150)
  startDate DateTime?
  endDate   DateTime?
  notes     String? @db.Text

  status    Status   @default(ACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant          @relation(fields: [tenantId], references: [id])
  boardTerm TenantBoardTerm @relation(fields: [boardTermId], references: [id])
  person    Person          @relation(fields: [personId], references: [id])

  @@index([tenantId, role])
  @@index([boardTermId])
  @@index([personId])
  @@map("tenant_board_members")
}

model TenantBoardTerm {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid

  name      String? @db.VarChar(150)
  startDate DateTime
  endDate   DateTime?
  notes     String? @db.Text

  status    Status   @default(ACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant              @relation(fields: [tenantId], references: [id])
  members   TenantBoardMember[]
  documents TenantDocument[]

  @@index([tenantId, startDate, endDate])
  @@map("tenant_board_terms")
}

model TenantDocument {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid

  boardTermId String? @db.Uuid

  type TenantDocumentType

  title       String  @db.VarChar(255)
  description String? @db.Text
  fileUrl     String  @db.VarChar(500)
  fileName    String? @db.VarChar(255)
  mimeType    String? @db.VarChar(100)

  documentDate DateTime?
  publishedAt  DateTime?
  expiresAt    DateTime?

  isPublic Boolean @default(false)

  status    Status    @default(ACTIVE)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  tenant    Tenant           @relation(fields: [tenantId], references: [id])
  boardTerm TenantBoardTerm? @relation(fields: [boardTermId], references: [id])

  @@index([tenantId, type])
  @@index([boardTermId])
  @@index([isPublic])
  @@map("tenant_documents")
}

// Modelos de controle de acesso
model User {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid

  email    String @unique @db.VarChar(255)
  password String @db.VarChar(100)

  mfaEnabled Boolean @default(false)

  status    Status    @default(ACTIVE)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  tenant          Tenant    @relation(fields: [tenantId], references: [id])
  roles           UserRole[]
  audits          Audit[]
  person          Person?
  tasksCreated    Task[]    @relation("taskCreator")
  tasksAssignedTo Task[]    @relation("taskAssignedTo")

  @@unique([tenantId, email])
  @@map("users")
}

model Role {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid

  name        String
  type        RoleType
  description String?

  status    Status    @default(ACTIVE)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  tenant      Tenant           @relation(fields: [tenantId], references: [id])
  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model UserRole {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  userId   String @db.Uuid
  roleId   String @db.Uuid

  assignedBy String?  @db.Uuid
  assignedAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id])
  role   Role   @relation(fields: [roleId], references: [id])

  @@unique([userId, roleId])
  @@map("user_roles")
}

model Permission {
  id          String @id @default(uuid()) @db.Uuid
  tenantId    String @db.Uuid
  name        String
  description String?
  type        PermissionType
  resource    String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  tenant Tenant           @relation(fields: [tenantId], references: [id])
  roles  RolePermission[]

  @@unique([tenantId, name, resource])
  @@map("permissions")
}

model RolePermission {
  id           String @id @default(uuid()) @db.Uuid
  tenantId     String @db.Uuid
  roleId       String @db.Uuid
  permissionId String @db.Uuid
  resource     String?

  tenant     Tenant     @relation(fields: [tenantId], references: [id])
  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@unique([roleId, permissionId, resource])
  @@map("role_permissions")
}

// Modelos de observabilidade como logs e auditorias.
model Audit {
  id       String    @id @default(uuid()) @db.Uuid
  tenantId String    @db.Uuid
  userId   String    @db.Uuid
  type     AuditType

  action   String
  entity   String
  entityId String?
  before   String?
  after    String?

  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@map("audits")
}

// Modelos de domínio com relacionamento direto a pessoas
model Person {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @db.Uuid
  name       String
  socialname String?
  birthDate  DateTime?
  gender     String?

  userId String? @unique @db.Uuid

  status    Status    @default(ACTIVE)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User?  @relation(fields: [userId], references: [id])

  contacts         Contact[]
  reports          Report[]
  documents        PersonDocument[]
  addresses        PersonAddress[]
  boardMemberships TenantBoardMember[]

  @@map("people")
}

model PersonAddress {
  id        String      @id @default(uuid()) @db.Uuid
  personId  String      @db.Uuid
  addressId String      @db.Uuid
  type      AddressType @default(HOME)
  isPrimary Boolean     @default(false)
  startedAt DateTime?
  endedAt   DateTime?

  person  Person  @relation(fields: [personId], references: [id])
  address Address @relation(fields: [addressId], references: [id])

  @@map("person_addresses")
}

model Address {
  id         String  @id @default(uuid()) @db.Uuid
  street     String
  number     String?
  district   String?
  city       String
  state      String
  zipCode    String
  country    String
  complement String?
  reference  String?

  status    Status    @default(ACTIVE)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  residents PersonAddress[]

  @@map("addresses")
}

model Contact {
  id       String      @id @default(uuid()) @db.Uuid
  personId String      @db.Uuid
  title    String
  type     ContactType
  value    String
  main     Boolean     @default(false)

  status    Status    @default(ACTIVE)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  person Person @relation(fields: [personId], references: [id])

  @@map("contacts")
}

model PersonDocument {
  id       String @id @default(uuid()) @db.Uuid
  personId String @db.Uuid

  type    DocumentType
  value   String
  storage String

  status    Status    @default(ACTIVE)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  person Person @relation(fields: [personId], references: [id])

  @@map("person_documents")
}

model Report {
  id         String     @id @default(uuid()) @db.Uuid
  tenantId   String     @db.Uuid
  title      String     @db.VarChar(255)
  content    String     @db.Text
  reportType ReportType

  createdAt  DateTime @default(now())
  createdBy  String   @db.Uuid
  assignedTo String?  @db.Uuid
  assignee   Person?  @relation(fields: [assignedTo], references: [id])

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("reports")
}

// Modelos de domínio relacionado a tarefas de usuários
model Task {
  id String @id @default(uuid()) @db.Uuid

  tenantId          String  @db.Uuid
  userId            String  @db.Uuid
  assignedToUserId  String? @db.Uuid

  title       String  @db.VarChar(255)
  description String? @db.Text

  status   TaskStatus   @default(PENDING)
  priority TaskPriority @default(MEDIUM)

  dueDate     DateTime?
  completedAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  tenant     Tenant @relation(fields: [tenantId], references: [id])
  creator    User   @relation("taskCreator", fields: [userId], references: [id])
  assignedTo User?  @relation("taskAssignedTo", fields: [assignedToUserId], references: [id])

  @@index([tenantId])
  @@index([userId])
  @@index([assignedToUserId])
  @@index([status])
  @@index([priority])
  @@map("tasks")
}
