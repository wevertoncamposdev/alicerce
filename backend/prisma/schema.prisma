// This is your Prisma schema file,
// learn more in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider     = "prisma-client"
  output       = "../src/core/prisma/generated"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Status {
  ACTIVE
  INACTIVE
  SUSPENDED
  ARCHIVED
}

enum RoleType {
  ADMIN
  USER
  GUEST
}

enum PermissionType {
  READ
  WRITE
  DELETE
}

enum AuditType {
  LOGIN
  LOGOUT
  DATA_CHANGE
  PERMISSION_CHANGE
  // Tentativa de acesso negada por falta de permissão (403) — só esse caso,
  // não 401 em geral: tenantId/userId são obrigatórios no model Audit, e um
  // 401 de token ausente/inválido não tem usuário identificável para
  // registrar.
  ACCESS_DENIED
  // Login com senha errada para um e-mail que existe — aqui sim há
  // tenantId/userId (o usuário foi encontrado, só a senha não bateu). Login
  // com e-mail inexistente continua sem auditoria: não há tenant/usuário a
  // quem atribuir o evento (ver AuthService.signIn).
  LOGIN_FAILED
}
