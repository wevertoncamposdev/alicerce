/// Main organizational entity of the system — identidade genérica de uma
/// instituição multi-tenant. Campos específicos de domínio (ONG) foram
/// removidos: ver docs/adr/0003-tenant-generico.md.
enum DocumentType {
    CNPJ
    CPF
    OUTRO
}

model Tenant {
    id String @id @default(uuid(7)) @db.Uuid

    legalName String  @unique @db.VarChar(255)
    slug      String  @unique @db.VarChar(120)
    tradeName String? @db.VarChar(255)

    // Fase 5 — campos institucionais genéricos (Plano Base.md 5.1). Dados
    // específicos de ONG não entram aqui (ADR 0003).
    documentType DocumentType?
    document     String?       @db.VarChar(20) // só dígitos — validado por @IsDocument()
    email        String?       @db.VarChar(255)
    phone        String?       @db.VarChar(20)
    website      String?       @db.VarChar(255)

    addressStreet       String? @db.VarChar(255)
    addressNumber       String? @db.VarChar(20)
    addressComplement   String? @db.VarChar(100)
    addressNeighborhood String? @db.VarChar(100)
    addressCity         String? @db.VarChar(100)
    addressState        String? @db.VarChar(2)
    addressZipCode      String? @db.VarChar(10)

    // Fase 6 — logo (Plano Base.md 6.4). Posse validada em quem anexa
    // (TenantService.update), não aqui — ver ADR 0010.
    logoFileId String? @db.Uuid
    logo       File?   @relation("TenantLogo", fields: [logoFileId], references: [id])

    status    Status    @default(ACTIVE)
    createdAt DateTime  @default(now())
    updatedAt DateTime  @updatedAt
    deletedAt DateTime?

    users           User[]
    roles           Role[]
    userRoles       UserRole[]
    rolePermissions RolePermission[]
    permissions     Permission[]
    audits          Audit[]
    feedbacks        Feedback[]
    feedbackComments FeedbackComment[]
    files            File[]            @relation("TenantFiles")

    @@index([slug])
    @@index([status])
    @@map("tenants")
}
