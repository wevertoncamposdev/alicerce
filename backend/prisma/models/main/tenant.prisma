/// Main organizational entity of the system.
model Tenant {
    id String @id @default(uuid(7)) @db.Uuid

    legalName          String  @unique @db.VarChar(255)
    tradeName          String? @db.VarChar(255)
    registrationNumber String  @unique @db.VarChar(20)
    slug               String  @unique @db.VarChar(120)

    description String? @db.Text
    mission     String? @db.Text
    vision      String? @db.Text
    values      String? @db.Text

    category           TenantCategory
    primaryServiceArea TenantServiceArea
    partnershipType    PartnershipType   @default(NONE)
    coverageArea       CoverageArea?
    organizationSize   OrganizationSize?

    foundedAt DateTime?
    closedAt  DateTime?

    street     String? @db.VarChar(255)
    number     String? @db.VarChar(50)
    district   String? @db.VarChar(150)
    city       String? @db.VarChar(150)
    state      String? @db.VarChar(100)
    zipCode    String? @db.VarChar(20)
    country    String? @db.VarChar(100)
    complement String? @db.VarChar(255)
    reference  String? @db.VarChar(255)

    phone       String? @db.VarChar(20)
    mobilePhone String? @db.VarChar(20)
    email       String? @db.VarChar(255)
    website     String? @db.VarChar(255)
    instagram   String? @db.VarChar(255)
    facebook    String? @db.VarChar(255)
    linkedin    String? @db.VarChar(255)

    usesVolunteers           Boolean @default(false)
    acceptsDonations         Boolean @default(false)
    hasGovernmentPartnership Boolean @default(false)
    isNonProfit              Boolean @default(true)

    notes String? @db.Text

    status    Status    @default(ACTIVE)
    createdAt DateTime  @default(now())
    updatedAt DateTime  @updatedAt
    deletedAt DateTime?

    serviceAreas    TenantArea[]
    users           User[]
    roles           Role[]
    userRoles       UserRole[]
    rolePermissions RolePermission[]
    permissions     Permission[]
    audits          Audit[]
    boardTerms      TenantBoardTerm[]
    boardMembers    TenantBoardMember[]
    documents       TenantDocument[]
    people          Person[]
    reports         Report[]
    tasks           Task[]
    favorites       Favorite[]
    favoriteNotes   FavoriteNote[]

    @@index([slug])
    @@index([registrationNumber])
    @@index([category])
    @@index([primaryServiceArea])
    @@index([status])
    @@map("tenants")
}

model TenantArea {
    id       String            @id @default(uuid(7)) @db.Uuid
    tenantId String            @db.Uuid
    area     TenantServiceArea

    tenant Tenant @relation(fields: [tenantId], references: [id])

    @@unique([tenantId, area])
    @@index([area])
    @@map("tenant_areas")
}

model TenantBoardMember {
    id          String @id @default(uuid(7)) @db.Uuid
    tenantId    String @db.Uuid
    boardTermId String @db.Uuid
    personId    String @db.Uuid

    role      BoardRoleType
    title     String?       @db.VarChar(150)
    startDate DateTime?
    endDate   DateTime?
    notes     String?       @db.Text

    status    Status   @default(ACTIVE)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    tenant    Tenant          @relation(fields: [tenantId], references: [id])
    boardTerm TenantBoardTerm @relation(fields: [boardTermId], references: [id])
    person    Person          @relation(fields: [personId], references: [id])

    @@index([tenantId, role])
    @@index([boardTermId])
    @@index([personId])
    @@map("tenant_board_members")
}

model TenantBoardTerm {
    id       String @id @default(uuid(7)) @db.Uuid
    tenantId String @db.Uuid

    name      String?   @db.VarChar(150)
    startDate DateTime
    endDate   DateTime?
    notes     String?   @db.Text

    status    Status   @default(ACTIVE)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    tenant    Tenant              @relation(fields: [tenantId], references: [id])
    members   TenantBoardMember[]
    documents TenantDocument[]

    @@index([tenantId, startDate, endDate])
    @@map("tenant_board_terms")
}

model TenantDocument {
    id       String @id @default(uuid(7)) @db.Uuid
    tenantId String @db.Uuid

    boardTermId String? @db.Uuid

    type TenantDocumentType

    title       String  @db.VarChar(255)
    description String? @db.Text
    fileUrl     String  @db.VarChar(500)
    fileName    String? @db.VarChar(255)
    mimeType    String? @db.VarChar(100)

    documentDate DateTime?
    publishedAt  DateTime?
    expiresAt    DateTime?

    isPublic Boolean @default(false)

    status    Status    @default(ACTIVE)
    createdAt DateTime  @default(now())
    updatedAt DateTime  @updatedAt
    deletedAt DateTime?

    tenant    Tenant           @relation(fields: [tenantId], references: [id])
    boardTerm TenantBoardTerm? @relation(fields: [boardTermId], references: [id])

    @@index([tenantId, type])
    @@index([boardTermId])
    @@index([isPublic])
    @@map("tenant_documents")
}
