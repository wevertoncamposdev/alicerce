/// Main organizational entity of the system — identidade genérica de uma
/// instituição multi-tenant. Campos específicos de domínio (ONG) foram
/// removidos: ver docs/adr/0003-tenant-generico.md.
model Tenant {
    id String @id @default(uuid(7)) @db.Uuid

    legalName String @unique @db.VarChar(255)
    slug      String @unique @db.VarChar(120)

    status    Status    @default(ACTIVE)
    createdAt DateTime  @default(now())
    updatedAt DateTime  @updatedAt
    deletedAt DateTime?

    users           User[]
    roles           Role[]
    userRoles       UserRole[]
    rolePermissions RolePermission[]
    permissions     Permission[]
    audits          Audit[]
    examples        Example[]
    exampleNotes    ExampleNote[]
    feedbacks        Feedback[]
    feedbackComments FeedbackComment[]

    @@index([slug])
    @@index([status])
    @@map("tenants")
}
