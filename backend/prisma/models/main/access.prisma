// Modelos de controle de acesso
model User {
    id       String  @id @default(uuid(7)) @db.Uuid
    tenantId String  @db.Uuid
    email    String  @unique @db.VarChar(255)
    // Nullable: usuário convidado (etapa 7.4) ainda não definiu senha —
    // computado como `pendingInvite` em UserMapper, nunca exposto crú.
    password String? @db.VarChar(100)
    name     String? @db.VarChar(255)
    theme    String? @db.VarChar(20)
    locale   String? @db.VarChar(10)

    // Quando o usuário foi convidado (etapa 7.4) — metadado histórico, fica
    // setado pra sempre, mesmo depois do convite aceito. `pendingInvite` usa
    // `password === null`, não este campo.
    invitedAt DateTime?

    // Verificação de e-mail no cadastro (etapa 7.5) — `emailVerified` no
    // AuthUserContext usa `emailVerifiedAt !== null`.
    emailVerifiedAt DateTime?

    // Fase 6 — avatar (Plano Base.md 6.4). Posse validada em quem anexa
    // (MeService.updateMe), não aqui — ver ADR 0010.
    avatarFileId String? @db.Uuid
    avatar       File?   @relation("UserAvatar", fields: [avatarFileId], references: [id])

    mfaEnabled Boolean @default(false)

    status    Status    @default(ACTIVE)
    createdAt DateTime  @default(now())
    updatedAt DateTime  @updatedAt
    deletedAt DateTime?

    tenant        Tenant         @relation(fields: [tenantId], references: [id])
    roles         UserRole[]
    audits        Audit[]
    refreshTokens RefreshToken[]
    feedbacks        Feedback[]
    feedbackComments FeedbackComment[]
    uploadedFiles    File[]            @relation("UploadedFiles")
    accountTokens    AccountToken[]

    @@map("users")
}

model Role {
    id       String @id @default(uuid(7)) @db.Uuid
    tenantId String @db.Uuid

    name        String
    type        RoleType
    description String?
    // ADR 0007: substitui `type === 'ADMIN'` em toda checagem de autorização
    // (último admin, bloqueio de exclusão/renomeação). `type`/`RoleType`
    // continuam existindo só como metadado, não decidem mais acesso.
    isSystem    Boolean   @default(false)

    status    Status    @default(ACTIVE)
    createdAt DateTime  @default(now())
    updatedAt DateTime  @updatedAt
    deletedAt DateTime?

    tenant      Tenant           @relation(fields: [tenantId], references: [id])
    users       UserRole[]
    permissions RolePermission[]

    @@index([tenantId])
    @@map("roles")
}

model UserRole {
    id       String @id @default(uuid(7)) @db.Uuid
    tenantId String @db.Uuid
    userId   String @db.Uuid
    roleId   String @db.Uuid

    assignedBy String?  @db.Uuid
    assignedAt DateTime @default(now())

    tenant Tenant @relation(fields: [tenantId], references: [id])
    user   User   @relation(fields: [userId], references: [id])
    role   Role   @relation(fields: [roleId], references: [id])

    @@unique([userId, roleId])
    @@index([tenantId])
    @@map("user_roles")
}

model Permission {
    id          String         @id @default(uuid(7)) @db.Uuid
    tenantId    String         @db.Uuid
    name        String
    description String?
    type        PermissionType
    resource    String?

    createdAt DateTime  @default(now())
    updatedAt DateTime  @updatedAt
    deletedAt DateTime?

    tenant Tenant           @relation(fields: [tenantId], references: [id])
    roles  RolePermission[]

    // @@unique já começa por tenantId, então também serve de índice para
    // consultas que filtram só por tenantId — não precisa de @@index extra.
    @@unique([tenantId, name, resource])
    @@map("permissions")
}

model RolePermission {
    id           String  @id @default(uuid(7)) @db.Uuid
    tenantId     String  @db.Uuid
    roleId       String  @db.Uuid
    permissionId String  @db.Uuid
    resource     String?

    tenant     Tenant     @relation(fields: [tenantId], references: [id])
    role       Role       @relation(fields: [roleId], references: [id])
    permission Permission @relation(fields: [permissionId], references: [id])

    @@unique([roleId, permissionId, resource])
    @@index([tenantId])
    @@map("role_permissions")
}

// Modelos de observabilidade como logs e auditorias.
model Audit {
    id       String    @id @default(uuid(7)) @db.Uuid
    tenantId String    @db.Uuid
    userId   String    @db.Uuid
    type     AuditType

    action   String
    entity   String
    entityId String?
    before   String?
    after    String?

    createdAt DateTime @default(now())

    tenant Tenant @relation(fields: [tenantId], references: [id])
    user   User   @relation(fields: [userId], references: [id])

    // Cobre os dois jeitos que AuditService.findAll consulta: trilha geral
    // do tenant ordenada por data, e trilha filtrada por entidade/registro
    // (usada pela aba de auditoria do DetailView no frontend).
    @@index([tenantId, createdAt])
    @@index([tenantId, entity, entityId])
    @@map("audits")
}
