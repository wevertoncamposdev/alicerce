model RefreshToken {
    id         String    @id @default(uuid(7)) @db.Uuid
    token      String    @unique // hash do token (nunca o token em claro)
    userId     String    @db.Uuid
    tenantId   String    @db.Uuid
    familyId   String    @db.Uuid // detectar reuso: toda rotação compartilha o mesmo familyId
    expiresAt  DateTime
    revokedAt  DateTime?
    // Só preenchido quando a revogação é uma ROTAÇÃO (token trocado por um
    // novo na mesma família, em refreshTokens) — nunca numa revogação de
    // segurança (logout, troca de senha, "encerrar sessão/outras"). É o que
    // diferencia as duas: só uma rotação legítima tolera reuso dentro da
    // janela de 10s (C4, etapa 12.5/F1) — ver AuthService.refreshTokens.
    replacedAt DateTime?
    createdAt  DateTime  @default(now())
    userAgent  String?   @db.VarChar(255)
    ip         String?   @db.VarChar(45)
    lastUsedAt DateTime?

    user User @relation(fields: [userId], references: [id])

    // familyId é consultado em toda rotação/revogação de refresh token
    // (AuthService.refreshTokens/revokeRefreshToken fazem updateMany por
    // familyId); userId é usado para revogar todas as sessões de um usuário.
    @@index([familyId])
    @@index([userId])
    @@map("refresh_tokens")
}
