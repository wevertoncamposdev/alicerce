model RefreshToken {
    id         String    @id @default(uuid(7)) @db.Uuid
    token      String    @unique // hash do token (nunca o token em claro)
    userId     String    @db.Uuid
    tenantId   String    @db.Uuid
    familyId   String    @db.Uuid // detectar reuso: toda rotação compartilha o mesmo familyId
    expiresAt  DateTime
    revokedAt  DateTime?
    createdAt  DateTime  @default(now())
    userAgent  String?   @db.VarChar(255)
    ip         String?   @db.VarChar(45)
    lastUsedAt DateTime?

    user User @relation(fields: [userId], references: [id])

    // familyId é consultado em toda rotação/revogação de refresh token
    // (AuthService.refreshTokens/revokeRefreshToken fazem updateMany por
    // familyId); userId é usado para revogar todas as sessões de um usuário.
    @@index([familyId])
    @@index([userId])
    @@map("refresh_tokens")
}
