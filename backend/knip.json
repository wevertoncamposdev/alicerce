{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreExportsUsedInFile": true,
  "entry": [
    "src/main.ts",
    "test/**/*.e2e-spec.ts",
    "scripts/**/*.ts"
  ],
  "project": [
    "src/**/*.ts",
    "test/**/*.ts",
    "prisma/**/*.ts",
    "scripts/**/*.ts"
  ],
  "ignoreDependencies": [
    "pino-pretty",
    "@nestjs/schematics"
  ]
}